---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Landing Agevia" headerVariant="auth">
	<main class="bg-[color:var(--background-principal)] px-4 py-16 text-[color:var(--texte-primaire)] sm:px-6 lg:px-8">
		<section class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
			<div class="space-y-6">
				<p class="text-sm uppercase tracking-[0.3em] text-[color:var(--texte-secondaire)]">Entraide locale</p>
				<h1 class="max-w-2xl font-oswald text-5xl leading-tight text-[color:var(--couleur-primaire)]" style="font-family: 'Oswald', sans-serif;">Agevia relie les besoins du quotidien aux bonnes personnes.</h1>
				<p class="max-w-2xl text-lg leading-8 text-[color:var(--texte-secondaire)]">
					Une plateforme pensée pour créer du lien, proposer de l’aide et trouver rapidement des missions adaptées.
				</p>
				<div class="flex flex-wrap gap-4">
					<a href="/connection" class="rounded-full border border-[color:var(--couleur-primaire)] px-6 py-3 font-semibold text-[color:var(--couleur-primaire)] no-underline transition hover:bg-[color:var(--couleur-primaire)] hover:text-white">Se connecter</a>
					<a href="/creacompte" class="rounded-full bg-[color:var(--couleur-primaire)] px-6 py-3 font-semibold text-white no-underline transition hover:bg-[color:var(--accent-primaire)]">Créer un compte</a>
				</div>
			</div>

			<div class="rounded-[2rem] border border-[color:var(--bordure)] bg-[color:var(--background-soft)] p-8 shadow-[0_20px_40px_rgba(47,93,98,0.08)]">
				<div class="space-y-4">
					<div class="h-40 rounded-[1.5rem] bg-gradient-to-br from-[#d9e5df] to-[#f1e4d2]"></div>
					<p class="text-sm leading-7 text-[color:var(--texte-secondaire)]">Le header de cette page reste volontairement épuré pour garder l’attention sur l’accès au compte et la création de compte.</p>
				</div>
			</div>
		</section>
	</main>
</Layout>
