---
import Layout from '../layouts/Layout.astro';
import '../scripts/signup.js';
---

<Layout>
  <div class="min-h-screen bg-[#fafaf8] flex items-center justify-center py-12 px-4">
    <div class="w-full max-w-md">
      <!-- Titre principal -->
      <div class="text-center mb-12">
        <p class="text-[#2e2e2e] text-sm mb-2">Vous allez bientôt aider nos seniors !</p>
        <h1 class="text-[#2e2e2e] text-3xl font-bold mb-1 font-oswald">Créer un compte pour rejoindre</h1>
        <p class="text-[#2f5d62] text-2xl font-bold font-oswald">Agevia</p>
      </div>

      <!-- Formulaire -->
      <form id="signupForm" method="POST" class="space-y-6">
        <!-- Email -->
        <div>
          <label for="email" class="block text-[#2e2e2e] font-medium mb-2">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Exemple@gmail.com"
            class="w-full px-4 py-3 rounded-full border-2 border-[#e0e0db] focus:border-[#2f5d62] focus:outline-none text-[#2e2e2e] placeholder-[#a8a8a8] transition"
            required
          />
        </div>

        <!-- Mot de passe -->
        <div>
          <label for="password" class="block text-[#2e2e2e] font-medium mb-2">Mot de passe</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••••"
            class="w-full px-4 py-3 rounded-full border-2 border-[#e0e0db] focus:border-[#2f5d62] focus:outline-none text-[#2e2e2e] placeholder-[#a8a8a8] transition"
            required
          />
          
          <!-- Critères de mot de passe -->
          <div class="mt-3 text-xs text-[#6b6b6b] space-y-1">
            <p class="font-medium">Le mot de passe doit contenir au moins 12 caractères et avoir au moins :</p>
            <ul class="list-disc list-inside space-y-1 ml-1">
              <li>3 numéros</li>
              <li>2 caractères spéciaux (- / # / * / ? ...)</li>
            </ul>
          </div>
        </div>

        <!-- Message d'erreur -->
        <div id="errorMessage" class="text-red-600 text-sm hidden"></div>

        <!-- Bouton principal -->
        <button
          type="submit"
          class="w-full py-3 rounded-full font-bold text-white transition-all duration-300 mt-8"
          style="background: linear-gradient(to right, #2f5d62, #9cc5a1); border: none; cursor: pointer;"
          onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 4px 12px rgba(47, 93, 98, 0.3)';"
          onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none';"
        >
          REJOINDRE AGEVIA
        </button>
      </form>

      <!-- Séparateur -->
      <div class="flex items-center my-8">
        <div class="flex-1 border-t border-[#e0e0db]"></div>
        <span class="px-3 text-xs text-[#6b6b6b]">Ou se connecter avec</span>
        <div class="flex-1 border-t border-[#e0e0db]"></div>
      </div>

      <!-- Boutons réseaux sociaux -->
      <div class="flex gap-4 justify-center mb-8">
        <!-- Google -->
        <button
          class="flex items-center justify-center w-14 h-14 rounded-lg border-2 border-[#e0e0db] hover:border-[#2f5d62] hover:bg-[#f2ece4] transition-all duration-200"
          title="Connexion avec Google"
        >
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
        </button>

        <!-- Facebook -->
        <button
          class="flex items-center justify-center w-14 h-14 rounded-lg border-2 border-[#e0e0db] hover:border-[#2f5d62] hover:bg-[#f2ece4] transition-all duration-200"
          title="Connexion avec Facebook"
        >
          <svg class="w-7 h-7 fill-[#1877F2]" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </button>
      </div>

      <!-- Lien connexion -->
      <div class="text-center">
        <p class="text-[#6b6b6b] text-sm">
          Vous avez déjà un compte ? 
          <a href="/connection" class="text-[#2f5d62] font-semibold hover:text-[#9cc5a1] transition-colors">
            Se connecter
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>