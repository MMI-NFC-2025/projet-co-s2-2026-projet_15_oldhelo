---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <div class="bg-[#fafaf8]">
    <section class="relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-[#f2ece4] to-transparent"></div>
      <div class="absolute -right-20 top-8 h-56 w-56 rounded-full bg-[#9cc5a1]/20 blur-3xl"></div>
      <div class="absolute -left-16 top-36 h-44 w-44 rounded-full bg-[#2f5d62]/10 blur-3xl"></div>

      <div class="relative mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
        <header class="max-w-3xl">
          <div class="space-y-2 mb-6">
            <p class="text-xs uppercase tracking-[0.28em] text-[#6b6b6b]">Parlons ensemble</p>
            <h1 class="font-oswald text-5xl text-[#2e2e2e] sm:text-6xl">Nous contacter</h1>
          </div>
          <p class="text-lg leading-8 text-[#6b6b6b] sm:text-xl max-w-2xl">
            Vous avez une question, une suggestion, ou besoin d'aide ? Contactez-nous via les informations ci-dessous ou en remplissant le formulaire.
          </p>
        </header>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Carte Email -->
        <article class="rounded-3xl border border-[#e0e0db] bg-white p-6 shadow-[0_10px_30px_rgba(47,93,98,0.06)]">
          <div class="mb-4 inline-flex rounded-full bg-[#f2ece4] px-4 py-2 text-sm font-semibold text-[#2f5d62]">
            Par email
          </div>
          <h2 class="mt-3 font-oswald text-2xl text-[#2e2e2e]">Adresse mail</h2>
          <p class="mt-4 text-base leading-8 text-[#6b6b6b]">
            Envoyez-nous un message et nous vous répondrons dans les plus brefs délais.
          </p>
          <a 
            href="mailto:agevia.support@gmail.com"
            class="mt-5 inline-flex items-center rounded-full border border-[#e0e0db] bg-[#fafaf8] px-5 py-3 text-sm font-semibold text-[#2f5d62] transition hover:border-[#2f5d62] hover:bg-[#f2ece4]"
          >
            agevia.support@gmail.com
          </a>
        </article>

        <!-- Carte Téléphone -->
        <article class="rounded-3xl border border-[#e0e0db] bg-[#f2ece4] p-6 shadow-[0_10px_30px_rgba(47,93,98,0.06)]">
          <div class="mb-4 inline-flex rounded-full bg-white px-4 py-2 text-sm font-semibold text-[#2f5d62]">
            Par téléphone
          </div>
          <h2 class="mt-3 font-oswald text-2xl text-[#2e2e2e]">Téléphone</h2>
          <p class="mt-4 text-base leading-8 text-[#6b6b6b]">
            Appelez-nous pour discuter directement de votre demande.
          </p>
          <a 
            href="tel:+33980971241"
            class="mt-5 inline-flex items-center rounded-full border border-[#e0e0db] bg-white px-5 py-3 text-sm font-semibold text-[#2f5d62] transition hover:border-[#2f5d62] hover:bg-[#f2ece4]"
          >
            +33 9 80 97 12 41
          </a>
        </article>
      </div>

      <!-- Bloc informations complémentaires -->
      <article class="mt-6 rounded-3xl border border-[#e0e0db] bg-gradient-to-r from-[#2f5d62] to-[#9cc5a1] p-8 text-white shadow-[0_14px_40px_rgba(47,93,98,0.12)]">
        <p class="text-xs uppercase tracking-[0.28em] text-white/80">Horaires</p>
        <h2 class="mt-3 font-oswald text-3xl sm:text-4xl">Disponibilité</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="text-sm font-semibold text-white/90">Jours ouvrables</p>
            <p class="mt-2 text-base leading-8 text-white/80">
              Lundi à vendredi<br />
              9h00 - 18h00
            </p>
          </div>
          <div>
            <p class="text-sm font-semibold text-white/90">Réponse à vos messages</p>
            <p class="mt-2 text-base leading-8 text-white/80">
              Sous 24 à 48 heures<br />
              en jours ouvrables
            </p>
          </div>
        </div>
      </article>

      <!-- Bloc formulaire de contact -->
      <article class="mt-6 rounded-3xl border border-[#e0e0db] bg-white p-6 shadow-[0_10px_30px_rgba(47,93,98,0.06)] sm:p-8">
        <p class="text-xs uppercase tracking-[0.28em] text-[#6b6b6b]">Formulaire</p>
        <h2 class="mt-3 font-oswald text-2xl text-[#2e2e2e]">Envoyez-nous un message</h2>
        
        <form id="contactForm" class="mt-6 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-semibold text-[#2e2e2e] mb-2">Nom</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                placeholder="Votre nom"
                class="w-full rounded-2xl border border-[#e0e0db] bg-[#fafaf8] px-4 py-3 text-[#2e2e2e] placeholder-[#a8a8a8] focus:border-[#2f5d62] focus:outline-none transition"
                required
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-[#2e2e2e] mb-2">Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="votre@email.com"
                class="w-full rounded-2xl border border-[#e0e0db] bg-[#fafaf8] px-4 py-3 text-[#2e2e2e] placeholder-[#a8a8a8] focus:border-[#2f5d62] focus:outline-none transition"
                required
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold text-[#2e2e2e] mb-2">Sujet</label>
            <input 
              type="text" 
              id="subject" 
              name="subject" 
              placeholder="Sujet de votre message"
              class="w-full rounded-2xl border border-[#e0e0db] bg-[#fafaf8] px-4 py-3 text-[#2e2e2e] placeholder-[#a8a8a8] focus:border-[#2f5d62] focus:outline-none transition"
              required
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-[#2e2e2e] mb-2">Message</label>
            <textarea 
              id="message" 
              name="message" 
              placeholder="Votre message..."
              rows="5"
              class="w-full rounded-2xl border border-[#e0e0db] bg-[#fafaf8] px-4 py-3 text-[#2e2e2e] placeholder-[#a8a8a8] focus:border-[#2f5d62] focus:outline-none transition resize-none"
              required
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full rounded-full bg-gradient-to-r from-[#2f5d62] to-[#9cc5a1] px-5 py-3 font-bold text-white transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_4px_12px_rgba(47,93,98,0.3)]"
          >
            Envoyer le message
          </button>
        </form>

        <div id="successMessage" class="mt-4 hidden rounded-2xl bg-green-100 border border-green-300 text-green-700 p-4">
          Merci ! Votre message a été envoyé avec succès.
        </div>
        <div id="errorMessage" class="mt-4 hidden rounded-2xl bg-red-100 border border-red-300 text-red-700 p-4"></div>
      </article>
    </section>
  </div>

  <script is:inline>
    // Contact form handler - opens mail client with pre-filled content
    const contactForm = document.getElementById('contactForm');
    const successMessage = document.getElementById('successMessage');
    const errorMessage = document.getElementById('errorMessage');

    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();

        const name = document.getElementById('name').value.trim();
        const email = document.getElementById('email').value.trim();
        const subject = document.getElementById('subject').value.trim();
        const message = document.getElementById('message').value.trim();

        if (!name || !email || !subject || !message) {
          errorMessage.textContent = 'Veuillez remplir tous les champs.';
          errorMessage.classList.remove('hidden');
          return;
        }

        // Créer le corps du message avec les informations de l'utilisateur
        const mailBody = `Nom: ${name}\nEmail: ${email}\n\n${message}`;

        // Créer le lien mailto
        const mailtoLink = `mailto:agevia.support@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(mailBody)}`;

        // Ouvrir le client email
        window.location.href = mailtoLink;

        // Afficher un message d'info
        successMessage.textContent = 'Votre client email va s\'ouvrir. Envoyez le message pour compléter votre demande.';
        successMessage.classList.remove('hidden');
        errorMessage.classList.add('hidden');
      });
    }
  </script>
</Layout>
