---
import Layout from '../layouts/Layout.astro';
---
<Layout>
    <main>
        <h1>Nous contacter</h1>
        <div class="contact">
            <div class="infos">
                <div>
                    <h3>Adresse mail</h3>
                    <a href="mailto:agevia.support@gmail.com">agevia.support@gmail.com</a>
                </div>
                <div>
                    <h3>Téléphone</h3>
                    <span>XXX.XXXXX.XXXX</span>
                </div>
            </div>
 
            <form>
                <div class="row">
                    <input type="text" placeholder="Prénom" required />
                    <input type="text" placeholder="Nom" required />
                </div>
                <input type="email" placeholder="Email" required />
                <textarea rows="5" placeholder="Votre message..." required></textarea>
                <button type="submit">Envoyer</button>
            </form>
        </div>
    </main>
</Layout>
 
<style>
    main {
        max-width: 900px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        font-family: 'Oswald', sans-serif;
    }
 
    h1 {
        font-size: 2rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 2.5rem;
        color: #2c2c2c;
    }
 
    .contact {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 3rem;
    }
 
    .infos { display: flex; flex-direction: column; gap: 1.5rem; }
 
    h3 {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #7a7a6a;
        margin: 0 0 0.3rem;
    }
 
    .infos a, .infos span {
        font-size: 0.95rem;
        color: #2c2c2c;
        text-decoration: none;
    }
 
    .infos a:hover { color: #4a8a6a; text-decoration: underline; }
 
    form { display: flex; flex-direction: column; gap: 1rem; }
 
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
 
    input, textarea {
        font-family: 'Oswald', sans-serif;
        font-size: 0.95rem;
        color: #2c2c2c;
        background: #f5f0e8;
        border: 1.5px solid #d8d0c0;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        outline: none;
        transition: border-color 0.2s;
        width: 100%;
    }
 
    input:focus, textarea:focus { border-color: #4a8a6a; }
    textarea { resize: vertical; }
 
    button {
        font-family: 'Oswald', sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #fff;
        background: #4a8a6a;
        border: none;
        border-radius: 8px;
        padding: 0.85rem 2rem;
        cursor: pointer;
        align-self: flex-start;
        transition: background 0.2s;
    }
 
    button:hover { background: #2d6a4a; }
 
    @media (max-width: 640px) {
        .contact { grid-template-columns: 1fr; }
        .row { grid-template-columns: 1fr; }
    }
</style>
