---
import "../styles/global.css";
import Image from 'astro/components/Image.astro';
import Explication from '../assets/icon/textless_logo.svg';
---
<footer class="bg-[#f2ece4] text-[#2e2e2e]">
  <div class="max-w-7xl mx-auto px-6 py-12">

    <div class="grid gap-12 md:grid-cols-[minmax(220px,1fr)_repeat(3,minmax(160px,1fr))] items-start">
      <div class="space-y-6">
        <div class="flex items-center gap-4">
          <Image src={Explication} alt="Agevia logo" class="w-14 h-10 object-contain" />
        </div>
       </div>

      <div class="space-y-3 text-sm">
        <p class="text-xs uppercase tracking-[0.24em] text-[#6B6B6B]">Info</p>
        <ul class="space-y-1">
          <li><a href="/missions" class="text-[#2e2e2e] hover:text-[#2f5d62] inline-block transition-transform duration-200 hover:scale-110">Annonces</a></li>
          <li><a href="/boutique" class="text-[#2e2e2e] hover:text-[#E2474B] inline-block transition-transform duration-200 hover:scale-110">Abonnements</a></li>
          <li><a href="/apropos" class="text-[#2e2e2e] hover:text-[#2f5d62] inline-block transition-transform duration-200 hover:scale-110">A Propos de nous</a></li>
          <li><a href="/faq" class="text-[#2e2e2e] hover:text-[#2f5d62] inline-block transition-transform duration-200 hover:scale-110">FAQ</a></li>
          <li><a href="/contact" class="text-[#2e2e2e] hover:text-[#2f5d62] inline-block transition-transform duration-200 hover:scale-110">Contact</a></li>
        </ul>
      </div>

      <div class="space-y-3 text-sm">
        <p class="text-xs uppercase tracking-[0.24em] text-[#6B6B6B]">Nous contacter</p>
        <ul class="space-y-2">
          <p
  class="text-[#2E2E2E] cursor-pointer transition hover:scale-105 hover:text-[#E2474B] inline-block"
  onclick="
    navigator.clipboard.writeText(this.innerText);

    const originalText = this.innerText;

    this.innerText = 'Copié !';
    this.style.color = '#22c55e'; // green

    setTimeout(() => {
      this.innerText = originalText;
      this.style.color = '#2E2E2E';
    }, 1200);
  "
> agevia.support@gmail.com</p>

        </ul>
      </div>

      <div class="space-y-3 text-sm">
        <p class="text-xs uppercase tracking-[0.24em] text-[#6B6B6B]">Juridique</p>
        <ul class="space-y-2">
          <li><a href="/legal" class="text-[#2e2e2e] hover:text-[#2f5d62] inline-block transition-transform duration-200 hover:scale-110">Mentions légales</a></li>
          <li><a href="/responsabilite" class="text-[#2e2e2e] hover:text-[#2f5d62] inline-block transition-transform duration-200 hover:scale-110">Responsabilité</a></li>
          <li><a href="/cgu_cgv" class="text-[#2e2e2e] hover:text-[#2f5d62] inline-block transition-transform duration-200 hover:scale-110">CGV/CGU</a></li>
          <li><a href="/policonfi" class="text-[#2e2e2e] hover:text-[#2f5d62] inline-block transition-transform duration-200 hover:scale-110">Politique de confidentialité</a></li>
          <li><a href="/transferargent" class="text-[#2e2e2e] hover:text-[#2f5d62] inline-block transition-transform duration-200 hover:scale-110">Modalités de transfert d'argent</a></li>
        </ul>
    </div>
  </div>
</footer>
