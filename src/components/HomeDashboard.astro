---
import Image from 'astro/components/Image.astro';
import AssignmentIcon from '../assets/icon/Assignment.svg';
import ShopIcon from '../assets/icon/Shop.svg';
import CheckboxIcon from '../assets/icon/Checkbox.svg';
import AtelierImage from '../assets/image/icon_service_ponctuel.webp';

const actionCards = [
  ['Créer une requête', 'Publier une demande en quelques étapes.', '/demander_aide', AssignmentIcon.src],
  ['Requêtes en cours', 'Retrouver les demandes actives et leur avancée.', '/requete', ShopIcon.src],
  ['Requêtes terminées', 'Consulter l’historique des missions validées.', '/missions', CheckboxIcon.src],
];

const newsSlides = [
  ['left', 'Lecture', 'Une activité locale à découvrir autour de vous.'],
  ['promo', 'Abonnement Agevia', 'Plus de fonctionnalités et moins de publicités !'],
  ['right', 'Atelier cuisine', 'Des idées simples pour cuisiner ensemble.'],
];
---

<main class="bg-[color:var(--background-principal)] text-[color:var(--texte-primaire)]">
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <div class="grid gap-4 md:grid-cols-3">
      {actionCards.map(([title, description, href, icon]) => (
        <a href={href} class="group rounded-[2rem] border border-[color:var(--bordure)] bg-[color:var(--background-soft)] p-6 text-center no-underline shadow-[0_10px_30px_rgba(47,93,98,0.06)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(47,93,98,0.12)]">
          <div class="mx-auto flex h-28 w-28 items-center justify-center rounded-[1.8rem] bg-white/70 transition duration-300 group-hover:bg-white">
            <img src={icon} alt="" aria-hidden="true" class="h-16 w-16" width="64" height="64" />
          </div>
          <h2 class="mt-6 font-oswald text-2xl tracking-wide text-[color:var(--couleur-primaire)]" style="font-family: 'Oswald', sans-serif;">{title}</h2>
          <p class="mt-3 text-sm leading-6 text-[color:var(--texte-secondaire)]">{description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="rounded-[2rem] border border-[color:var(--bordure)] bg-[color:var(--background-soft)] p-4 sm:p-6 lg:p-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.24em] text-[color:var(--texte-secondaire)]">Nouvelles autour de vous</p>
          <h2 class="mt-2 font-oswald text-3xl text-[color:var(--couleur-primaire)]" style="font-family: 'Oswald', sans-serif;">Nouvelles autour de vous</h2>
        </div>
      </div>

      <div class="mt-6 overflow-hidden">
        <div class="relative">
          <button type="button" data-carousel-prev aria-label="Aller au cadre précédent" class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-[color:var(--couleur-secondaire)] p-3 text-[color:var(--couleur-primaire)] shadow-lg transition hover:scale-105">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>

          <button type="button" data-carousel-next aria-label="Aller au cadre suivant" class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-[color:var(--couleur-secondaire)] p-3 text-[color:var(--couleur-primaire)] shadow-lg transition hover:scale-105">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>

          <div class="carousel-viewport overflow-hidden px-10 py-2">
            <div data-carousel-track class="flex items-center gap-6 transition-transform duration-500 ease-out will-change-transform">
              {newsSlides.map(([kind, title, description]) => (
                kind === 'promo' ? (
                  <article class="carousel-slide flex-none w-[24rem] rounded-[1.8rem] overflow-hidden border-2 border-[color:var(--couleur-secondaire)] shadow-[0_10px_30px_rgba(47,93,98,0.12)]">
                    <div class="flex h-[12rem] flex-col justify-between bg-[linear-gradient(135deg,#f4ede2_0%,#f9f6ef_45%,#eef4ee_100%)] p-5 text-center">
                      <div>
                        <p class="text-xs uppercase tracking-[0.28em] text-[color:var(--texte-secondaire)]">Abonnement Agevia</p>
                        <h3 class="mt-3 font-oswald text-3xl leading-tight text-[color:var(--couleur-primaire)]" style="font-family: 'Oswald', sans-serif;">{description}</h3>
                      </div>
                      <a href="/abonnement" class="mt-4 inline-flex items-center justify-center rounded-full bg-[color:var(--couleur-primaire)] px-5 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-white no-underline transition hover:bg-[color:var(--accent-primaire)]">
                        S’abonner tout de suite
                      </a>
                    </div>
                  </article>
                ) : (
                  <article class="carousel-slide flex-none w-[18rem] rounded-[1.6rem] overflow-hidden shadow-[0_10px_30px_rgba(47,93,98,0.12)]">
                    <div class="relative h-[12rem] text-white">
                      <Image src={AtelierImage} alt="Nouvelle locale" class="h-full w-full object-cover" />
                      <div class="absolute inset-0 bg-black/18"></div>
                      <div class="absolute inset-x-0 bottom-0 p-4">
                        <p class="text-sm font-semibold drop-shadow">{title}</p>
                        <p class="text-xs leading-5 drop-shadow">{description}</p>
                      </div>
                    </div>
                  </article>
                )
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
  // @ts-nocheck
  const track = document.querySelector('[data-carousel-track]');
  const buttons = [document.querySelector('[data-carousel-prev]'), document.querySelector('[data-carousel-next]')];

  if (track instanceof HTMLElement && buttons.every((button) => button instanceof HTMLButtonElement)) {
    const slides = [...track.querySelectorAll('.carousel-slide')].filter((slide) => slide instanceof HTMLElement);
    let activeIndex = 1;
    const render = () => {
      const slide = slides[activeIndex];
      const viewport = track.parentElement;

      if (slide instanceof HTMLElement && viewport instanceof HTMLElement) {
        track.style.transform = `translateX(${-(slide.offsetLeft + slide.offsetWidth / 2 - viewport.clientWidth / 2)}px)`;
      }
    };
    const move = (step) => { activeIndex = (activeIndex + step + slides.length) % slides.length; render(); };
    buttons[0].addEventListener('click', () => move(-1));
    buttons[1].addEventListener('click', () => move(1));
    window.addEventListener('resize', render);
    render();
  }
</script>